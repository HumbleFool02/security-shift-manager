# Copy this file to .env and fill in real values. .env is gitignored and
# never committed -- see main.py for how each variable is consumed.

# SQLAlchemy connection string for the MySQL database (PyMySQL driver).
# Defaults to mysql://root:@localhost/onlinesystem if unset.
DATABASE_URL=mysql://root:@localhost/onlinesystem

# Used to sign JWT session tokens and as the Flask session secret.
# Defaults to a hardcoded, insecure value if unset -- always set a real
# random string outside of local/dev use.
SECRET_KEY=change-this-to-a-long-random-string

# How many hours a login session (JWT) stays valid before requiring
# re-login. Defaults to 8 if unset.
JWT_EXPIRY_HOURS=8
